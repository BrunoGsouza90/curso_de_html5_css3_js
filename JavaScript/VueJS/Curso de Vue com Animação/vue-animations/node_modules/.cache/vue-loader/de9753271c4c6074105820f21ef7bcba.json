C,CAAC,CAAC,EAAE;;MAEN,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;;MAE3B,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;;MAEvB,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,EAAE,CAAC,EAAE;;QAEzB,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC;;QAEtB,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC;;MAEhD;;MAEA,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC,CAAC,CAAC,CAAC,EAAE;;IAE1C;;EAEF","file":"/home/bruno/dev/apache/Bruno/curso_de_html5_css3_js/JavaScript/VueJS/Curso de Vue com Animação/vue-animations/src/views/Home.vue","sourceRoot":"","sourcesContent":["<script>\n\n  import { ref } from 'vue'\n  import Toast from '../components/Toast'\n  import Todos from '../components/Todos'\n\n  export default {\n\n    components: { Toast, Todos },\n\n    setup() {\n\n      const showToast = ref(false)\n\n      const showP = ref(false)\n\n      const triggerToast = () => {\n\n        showToast.value = true;\n\n        setTimeout(() => showToast.value = false, 3000)\n\n      }\n\n      return { showToast, triggerToast, showP }\n\n    }\n\n  }\n  \n</script>\n\n<template>\n\n  <div class=\"home\">\n\n    <transition name=\"toast\">\n    \n      <Toast v-if=\"showToast\"/>\n\n    </transition>\n\n    <Todos @badValue=\"triggerToast\"/>\n    \n    <transition name=\"fade\">\n\n      <div v-if=\"showP\">Olá, Ninjas!</div>\n    \n    </transition>\n\n    <button @click=\"showP = !showP\" type=\"button\">Toggle</button>\n\n  </div>\n\n</template>\n\n<style>\n\n\n  /* Transições \"fade\". */\n  .fade-enter-from {\n\n    opacity: 0;\n\n  }\n\n  .fade-enter-to {\n\n    opacity: 1;\n\n  }\n\n  .fade-enter-active {\n\n    transition: all 2s ease-in-out;\n\n  }\n\n  .fade-leave-from {\n\n    opacity: 1;\n\n  }\n\n  .fade-leave-to {\n\n      opacity: 0;\n\n  }\n\n  .fade-leave-active {\n\n    transition: all 2s ease-in-out;\n\n  }\n\n  /* Transições \"toast\". */\n  /* Comentamos para usar o Keyframes \"wobble\" no transform, pois este já está cumprindo o o papel dos parâmetros de entrada e saída da animação. */\n  /* .toast-enter-from {\n\n    opacity: 0;\n    transform: translateY(-60px);\n\n  }\n\n  .toast-enter-to {\n\n    opacity: 1;\n    transform: translateY(0px);\n\n  } */\n\n  .toast-enter-active {\n\n    animation: wobble 0.5s ease;\n\n  }\n\n  .toast-leave-from {\n\n    opacity: 1;\n    transform: translateY(0px);\n\n  }\n\n  .toast-leave-to {\n\n    opacity: 0;\n    transform: translateY(-60px);\n\n  }\n\n  .toast-leave-active {\n\n    transition: all 0.3s ease-in-out;\n\n  }\n\n  @keyframes wobble {\n\n    0% {\n\n      transform: translateY(-60px);\n      opacity: 0;\n\n    }\n\n    50% {\n\n      transform: translateY(0px);\n      opacity: 1;\n\n    }\n\n    60% {\n\n      transform: translateX(8px);\n\n    }\n\n    70% {\n\n      transform: translateX(-8px);\n\n    }\n    \n    80% {\n\n      transform: translateX(4px);\n\n    }\n\n    90% {\n\n      transform: translateX(-4px);\n\n    }\n\n    100% {\n\n      transform: translateX(0px);\n\n    }\n\n  }\n\n</style>"]}]}