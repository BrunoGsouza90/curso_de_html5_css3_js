{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  setup() {\n    const showTitle = ref(true);\n    const beforeEnter = () => {\n      console.log(\"Before enter\");\n    };\n    const enter = () => {\n      console.log(\"Enter\");\n    };\n    const afterEnter = () => {\n      console.log(\"After enter \");\n      setTimeout(() => {\n        showTitle.value = false;\n      }, 2000);\n    };\n    const beforeLeave = () => {\n      console.log(\"Enter\");\n    };\n    const leave = () => {\n      console.log(\"Enter\");\n    };\n    return {\n      showTitle,\n      beforeEnter,\n      enter,\n      afterEnter\n    };\n  }\n};","map":{"version":3,"names":["ref","setup","showTitle","beforeEnter","console","log","enter","afterEnter","setTimeout","value","beforeLeave","leave"],"sources":["/home/bruno/dev/apache/Bruno/curso_de_html5_css3_js/JavaScript/VueJS/Curso de Vue com Animação/vue-animations/src/views/About.vue"],"sourcesContent":["<script>\n\n  import { ref } from 'vue';\n\n  export default {\n\n    setup() {\n\n      const showTitle = ref(true)\n\n      const beforeEnter = () => {\n\n        console.log(\"Before enter\")\n\n      }\n\n      const enter = () => {\n\n        console.log(\"Enter\")\n\n      }\n\n      const afterEnter = () => {\n\n        console.log(\"After enter \")\n\n        setTimeout(() => {\n\n          showTitle.value = false\n\n        }, 2000)\n\n      }\n\n      const beforeLeave = () => {\n\n        console.log(\"Enter\")\n\n      }\n\n      const leave = () => {\n\n        console.log(\"Enter\")\n\n      }\n\n      return { showTitle, beforeEnter, enter, afterEnter }\n\n    }\n\n  }\n\n</script>\n\n<template>\n\n  <div class=\"about\">\n\n    <transition\n      appear \n      name=\"fade\"\n      @before-enter=\"beforeEnter\"\n      @enter=\"enter\"\n      @after-enter=\"afterEnter\"\n      @before-leave=\"beforeLeave\"\n      @leave=\"leave\"\n      @after-leave=\"afterLeave\"\n    >\n    \n      <h1 v-if=\"showTitle\">About</h1>\n\n    </transition>\n\n    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Cum aperiam officia possimus delectus inventore quod quisquam culpa voluptas iusto, quae maiores quo dolorum, corporis laboriosam a dolore consequatur assumenda nam!</p>\n\n    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Cum aperiam officia possimus delectus inventore quod quisquam culpa voluptas iusto, quae maiores quo dolorum, corporis laboriosam a dolore consequatur assumenda nam!</p>\n\n    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Cum aperiam officia possimus delectus inventore quod quisquam culpa voluptas iusto, quae maiores quo dolorum, corporis laboriosam a dolore consequatur assumenda nam!</p>\n\n  </div>\n\n</template>\n\n<style>\n\n  .about {\n\n    max-width: 600px;\n    margin: 20px auto;\n\n  }\n\n  .fade-enter-from,\n  .fade-leave-to {\n\n    opacity: 0;\n\n  }\n\n  .fade-enter-to,\n  .fade-leave-from {\n\n    opacity: 1;\n\n  }\n\n  .fade-enter-active,\n  .fade-leave-active {\n\n    transform: all 3s ease;\n\n  }\n\n</style>"],"mappings":"AAEE,SAASA,GAAE,QAAS,KAAK;AAEzB,eAAe;EAEbC,KAAKA,CAAA,EAAG;IAEN,MAAMC,SAAQ,GAAIF,GAAG,CAAC,IAAI;IAE1B,MAAMG,WAAU,GAAIA,CAAA,KAAM;MAExBC,OAAO,CAACC,GAAG,CAAC,cAAc;IAE5B;IAEA,MAAMC,KAAI,GAAIA,CAAA,KAAM;MAElBF,OAAO,CAACC,GAAG,CAAC,OAAO;IAErB;IAEA,MAAME,UAAS,GAAIA,CAAA,KAAM;MAEvBH,OAAO,CAACC,GAAG,CAAC,cAAc;MAE1BG,UAAU,CAAC,MAAM;QAEfN,SAAS,CAACO,KAAI,GAAI,KAAI;MAExB,CAAC,EAAE,IAAI;IAET;IAEA,MAAMC,WAAU,GAAIA,CAAA,KAAM;MAExBN,OAAO,CAACC,GAAG,CAAC,OAAO;IAErB;IAEA,MAAMM,KAAI,GAAIA,CAAA,KAAM;MAElBP,OAAO,CAACC,GAAG,CAAC,OAAO;IAErB;IAEA,OAAO;MAAEH,SAAS;MAAEC,WAAW;MAAEG,KAAK;MAAEC;IAAW;EAErD;AAEF","ignoreList":[]},"metadata":{},"sourceType":"module"}