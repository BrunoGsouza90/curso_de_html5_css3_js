{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  setup() {\n    const showTitle = ref(true);\n    const beforeEnter = el => {\n      console.log(\"Before enter\");\n    };\n    const enter = el => {\n      console.log(\"Enter\");\n    };\n    const afterEnter = el => {\n      console.log(\"After enter \");\n      setTimeout(el => {\n        showTitle.value = false;\n      }, 2000);\n    };\n    const beforeLeave = el => {\n      console.log(\"Before leave\");\n    };\n    const leave = el => {\n      console.log(\"Leave\");\n    };\n    const afterLeave = el => {\n      console.log(\"After leave\");\n    };\n    return {\n      showTitle,\n      beforeEnter,\n      enter,\n      afterEnter,\n      beforeLeave,\n      leave,\n      afterLeave\n    };\n  }\n};","map":{"version":3,"names":["ref","setup","showTitle","beforeEnter","el","console","log","enter","afterEnter","setTimeout","value","beforeLeave","leave","afterLeave"],"sources":["/home/bruno/dev/apache/Bruno/curso_de_html5_css3_js/JavaScript/VueJS/Curso de Vue com Animação/vue-animations/src/views/About.vue"],"sourcesContent":["<script>\n\n  import { ref } from 'vue';\n\n  export default {\n\n    setup() {\n\n      const showTitle = ref(true)\n\n      const beforeEnter = (el) => {\n\n        console.log(\"Before enter\")\n\n      }\n\n      const enter = (el) => {\n\n        console.log(\"Enter\")\n\n      }\n\n      const afterEnter = (el) => {\n\n        console.log(\"After enter \")\n\n        setTimeout((el) => {\n\n          showTitle.value = false\n\n        }, 2000)\n\n      }\n\n      const beforeLeave = (el) => {\n\n        console.log(\"Before leave\")\n\n      }\n\n      const leave = (el) => {\n\n        console.log(\"Leave\")\n\n      }\n\n      const afterLeave = (el) => {\n\n        console.log(\"After leave\")\n\n      }\n\n      return { showTitle, beforeEnter, enter, afterEnter, beforeLeave, leave, afterLeave }\n\n    }\n\n  }\n\n</script>\n\n<template>\n\n  <div class=\"about\">\n\n    <transition\n      appear \n      name=\"fade\"\n      @before-enter=\"beforeEnter\"\n      @enter=\"enter\"\n      @after-enter=\"afterEnter\"\n      @before-leave=\"beforeLeave\"\n      @leave=\"leave\"\n      @after-leave=\"afterLeave\"\n    >\n    \n      <h1 v-if=\"showTitle\">About</h1>\n\n    </transition>\n\n    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Cum aperiam officia possimus delectus inventore quod quisquam culpa voluptas iusto, quae maiores quo dolorum, corporis laboriosam a dolore consequatur assumenda nam!</p>\n\n    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Cum aperiam officia possimus delectus inventore quod quisquam culpa voluptas iusto, quae maiores quo dolorum, corporis laboriosam a dolore consequatur assumenda nam!</p>\n\n    <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Cum aperiam officia possimus delectus inventore quod quisquam culpa voluptas iusto, quae maiores quo dolorum, corporis laboriosam a dolore consequatur assumenda nam!</p>\n\n  </div>\n\n</template>\n\n<style>\n\n  .about {\n\n    max-width: 600px;\n    margin: 20px auto;\n\n  }\n\n  .fade-enter-from,\n  .fade-leave-to {\n\n    opacity: 0;\n\n  }\n\n  .fade-enter-to,\n  .fade-leave-from {\n\n    opacity: 1;\n\n  }\n\n  .fade-enter-active,\n  .fade-leave-active {\n\n    transform: all 3s ease;\n\n  }\n\n</style>"],"mappings":"AAEE,SAASA,GAAE,QAAS,KAAK;AAEzB,eAAe;EAEbC,KAAKA,CAAA,EAAG;IAEN,MAAMC,SAAQ,GAAIF,GAAG,CAAC,IAAI;IAE1B,MAAMG,WAAU,GAAKC,EAAE,IAAK;MAE1BC,OAAO,CAACC,GAAG,CAAC,cAAc;IAE5B;IAEA,MAAMC,KAAI,GAAKH,EAAE,IAAK;MAEpBC,OAAO,CAACC,GAAG,CAAC,OAAO;IAErB;IAEA,MAAME,UAAS,GAAKJ,EAAE,IAAK;MAEzBC,OAAO,CAACC,GAAG,CAAC,cAAc;MAE1BG,UAAU,CAAEL,EAAE,IAAK;QAEjBF,SAAS,CAACQ,KAAI,GAAI,KAAI;MAExB,CAAC,EAAE,IAAI;IAET;IAEA,MAAMC,WAAU,GAAKP,EAAE,IAAK;MAE1BC,OAAO,CAACC,GAAG,CAAC,cAAc;IAE5B;IAEA,MAAMM,KAAI,GAAKR,EAAE,IAAK;MAEpBC,OAAO,CAACC,GAAG,CAAC,OAAO;IAErB;IAEA,MAAMO,UAAS,GAAKT,EAAE,IAAK;MAEzBC,OAAO,CAACC,GAAG,CAAC,aAAa;IAE3