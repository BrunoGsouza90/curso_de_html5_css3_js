{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { ref } from 'vue';\nexport default {\n  setup(props, {\n    emit\n  }) {\n    const todos = ref([{\n      text: 'make the bed',\n      id: 1\n    }, {\n      text: 'play video games',\n      id: 2\n    }]);\n    const newTodo = ref('');\n    const addTodo = () => {\n      if (newTodo.value) {\n        const id = Math.random();\n        todos.value = [{\n          text: newTodo.value,\n          id\n        }, ...todos.value];\n        newTodo.value = '';\n      } else {\n        emit('badValue');\n      }\n    };\n    const deleteTodo = id => {\n      todos.value = todos.value.filter(todo => todo.id != id);\n    };\n    return {\n      todos,\n      addTodo,\n      deleteTodo,\n      newTodo\n    };\n  }\n};","map":{"version":3,"names":["ref","setup","props","emit","todos","text","id","newTodo","addTodo","value","Math","random","deleteTodo","filter","todo"],"sources":["/home/bruno/dev/apache/Bruno/curso_de_html5_css3_js/JavaScript/VueJS/Curso de Vue com Animação/vue-animations/src/components/Todos.vue"],"sourcesContent":["<template>\n\n  <div class=\"todos\">\n\n    <input \n      type=\"text\" \n      v-model=\"newTodo\" \n      @keypress.enter=\"addTodo\"\n      placeholder=\"Add a new todo...\"\n    />\n\n    <div v-if=\"todos.length\">\n\n      <ul>\n\n        <li v-for=\"todo in todos\" :key=\"todo.id\" @click=\"deleteTodo(todo.id)\">\n\n          {{ todo.text }}\n\n        </li>\n\n      </ul>\n\n    </div>\n\n    <div v-else>Woohoo, nothing left todo!</div>\n\n  </div>\n\n</template>\n\n<script>\n\nimport { ref } from 'vue'\n\nexport default {\n\n  setup(props, { emit }) {\n\n    const todos = ref([\n\n      { text: 'make the bed', id: 1 },\n      { text: 'play video games', id: 2 }\n\n    ])\n\n    const newTodo = ref('')\n\n    const addTodo = () => {\n\n      if (newTodo.value) {\n\n        const id = Math.random()\n        \n        todos.value = [{ text: newTodo.value, id }, ...todos.value]\n        newTodo.value = ''\n      } else {\n        emit('badValue')\n      }\n    }\n\n    const deleteTodo = (id) => {\n      todos.value = todos.value.filter(todo => todo.id != id)\n    }\n\n    return { todos, addTodo, deleteTodo, newTodo }\n  }\n}\n</script>\n\n<style>\n  .todos {\n    max-width: 400px;\n    margin: 20px auto;\n    position: relative;\n  }\n  input {\n    width: 100%;\n    padding: 12px;\n    border: 1px solid #eee;\n    border-radius: 10px;\n    box-sizing: border-box;\n    margin-bottom: 20px;\n  }\n  .todos ul {\n    position: relative;\n    padding: 0;\n  }\n  .todos li {\n    list-style-type: none;\n    display: block;\n    margin-bottom: 10px;\n    padding: 10px;\n    background: white;\n    box-shadow: 1px 3px 5px rgba(0,0,0,0.1);\n    border-radius: 10px;\n    width: 100%;\n    box-sizing: border-box;\n  }\n  .todos li:hover {\n    cursor: pointer;\n  }\n</style>"],"mappings":";;AAiCA,SAASA,GAAE,QAAS,KAAI;AAExB,eAAe;EAEbC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IAErB,MAAMC,KAAI,GAAIJ,GAAG,CAAC,CAEhB;MAAEK,IAAI,EAAE,cAAc;MAAEC,EAAE,EAAE;IAAE,CAAC,EAC/B;MAAED,IAAI,EAAE,kBAAkB;MAAEC,EAAE,EAAE;IAAE,EAEnC;IAED,MAAMC,OAAM,GAAIP,GAAG,CAAC,EAAE;IAEtB,MAAMQ,OAAM,GAAIA,CAAA,KAAM;MAEpB,IAAID,OAAO,CAACE,KAAK,EAAE;QAEjB,MAAMH,EAAC,GAAII,IAAI,CAACC,MAAM,CAAC;QAEvBP,KAAK,CAACK,KAAI,GAAI,CAAC;UAAEJ,IAAI,EAAEE,OAAO,CAACE,KAAK;UAAEH;QAAG,CAAC,EAAE,GAAGF,KAAK,CAACK,KAAK;QAC1DF,OAAO,CAACE,KAAI,GAAI,EAAC;MACnB,OAAO;QACLN,IAAI,CAAC,UAAU;MACjB;IACF;IAEA,MAAMS,UAAS,GAAKN,EAAE,IAAK;MACzBF,KAAK,CAACK,KAAI,GAAIL,KAAK,CAACK,KAAK,CAACI,MAAM,CAACC,IAAG,IAAKA,IAAI,CAACR,EAAC,IAAKA,EAAE;IACxD;IAEA,OAAO;MAAEF,KAAK;MAAEI,OAAO;MAAEI,UAAU;MAAEL;IAAQ;EAC/C;AACF","ignoreList":[]},"metadata":{},"sourceType":"module"}