{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { ref } from 'vue';\nexport default {\n  setup(props, {\n    emit\n  }) {\n    const todos = ref([{\n      text: 'make the bed',\n      id: 1\n    }, {\n      text: 'play video games',\n      id: 2\n    }]);\n    const newTodo = ref('');\n    const addTodo = () => {\n      if (newTodo.value) {\n        const id = Math.random();\n        todos.value = [{\n          text: newTodo.value,\n          id\n        }, ...todos.value];\n        newTodo.value = '';\n      } else {\n        emit('badValue');\n      }\n    };\n    const deleteTodo = id => {\n      todos.value = todos.value.filter(todo => todo.id != id);\n    };\n    return {\n      todos,\n      addTodo,\n      deleteTodo,\n      newTodo\n    };\n  }\n};","map":{"version":3,"names":["ref","setup","props","emit","todos","text","id","newTodo","addTodo","value","Math","random","deleteTodo","filter","todo"],"sources":["/home/bruno/dev/apache/Bruno/curso_de_html5_css3_js/JavaScript/VueJS/Curso de Vue com Animação/vue-animations/src/components/Todos.vue"],"sourcesContent":["\n<script>\n\n  import { ref } from 'vue'\n\n  export default {\n\n    setup(props, { emit }) {\n\n      const todos = ref([\n\n        { text: 'make the bed', id: 1 },\n        { text: 'play video games', id: 2 }\n\n      ])\n\n      const newTodo = ref('')\n\n      const addTodo = () => {\n\n        if (newTodo.value) {\n\n          const id = Math.random()\n\n          todos.value = [{ text: newTodo.value, id }, ...todos.value]\n\n          newTodo.value = ''\n\n        } else {\n\n          emit('badValue')\n\n        }\n\n      }\n\n      const deleteTodo = (id) => {\n\n        todos.value = todos.value.filter(todo => todo.id != id)\n\n      }\n\n      return { todos, addTodo, deleteTodo, newTodo }\n\n    }\n\n  }\n\n</script>\n\n<template>\n\n  <div class=\"todos\">\n\n    <input \n      type=\"text\" \n      v-model=\"newTodo\" \n      @keypress.enter=\"addTodo\"\n      placeholder=\"Add a new todo...\"\n    />\n\n    <transition name=\"switch\">\n\n      <div v-if=\"todos.length\">\n\n        <transition-group tag=\"ul\" name=\"list\" appear>\n\n          <li v-for=\"todo in todos\" :key=\"todo.id\" @click=\"deleteTodo(todo.id)\">\n\n            {{ todo.text }}\n\n          </li>\n\n        </transition-group>\n\n      </div>\n\n      <div v-else>Woohoo, nothing left todo!</div>\n\n    </transition>\n\n  </div>\n\n</template>\n\n<style>\n\n  .todos {\n\n    max-width: 400px;\n    margin: 20px auto;\n    position: relative;\n\n  }\n\n  input {\n\n    width: 100%;\n    padding: 12px;\n    border: 1px solid #eee;\n    border-radius: 10px;\n    box-sizing: border-box;\n    margin-bottom: 20px;\n\n  }\n  .todos ul {\n\n    position: relative;\n    padding: 0;\n\n  }\n\n  .todos li {\n\n    list-style-type: none;\n    display: block;\n    margin-bottom: 10px;\n    padding: 10px;\n    background: white;\n    box-shadow: 1px 3px 5px rgba(0,0,0,0.1);\n    border-radius: 10px;\n    width: 100%;\n    box-sizing: border-box;\n\n  }\n\n  .todos li:hover {\n\n    cursor: pointer;\n\n  }\n\n  /* Animação para o Grupo de Transição \"list\". */\n  .list-enter-from {\n\n    opacity: 0;\n    transform: scale(0.6);\n\n  }\n\n  .list-enter-to {\n\n    opacity: 1;\n    transform: scale(1);\n\n  }\n\n  .list-enter-active {\n\n    transition: all 0.4s ease;\n\n  }\n\n  .list-leave-from {\n\n    opacity: 1;\n    transform: scale(1);\n\n  }\n\n  .list-leave-to {\n\n    opacity: 0;\n    transform: scale(0.6);\n\n  }\n\n  .list-leave-active {\n\n    transition: all 0.4s ease;\n    position: absolute;\n\n  }\n\n  .list-move {\n\n    transition: all 0.3s ease;\n\n  }\n\n  /* Animações \"switch\". */\n  .switch-enter-from,\n  .switch-leave-to {\n\n    opacity: 0;\n    transform: translateY(20px);\n\n  }\n\n  .switch-enter-to,\n  .switch-leave-from {\n\n    opacity: ;\n\n  }\n\n  .switch-enter-active {}\n\n  .switch-leave-active {}\n\n</style>"],"mappings":";;AAGE,SAASA,GAAE,QAAS,KAAI;AAExB,eAAe;EAEbC,KAAKA,CAACC,KAAK,EAAE;IAAEC;EAAK,CAAC,EAAE;IAErB,MAAMC,KAAI,GAAIJ,GAAG,CAAC,CAEhB;MAAEK,IAAI,EAAE,cAAc;MAAEC,EAAE,EAAE;IAAE,CAAC,EAC/B;MAAED,IAAI,EAAE,kBAAkB;MAAEC,EAAE,EAAE;IAAE,EAEnC;IAED,MAAMC,OAAM,GAAIP,GAAG,CAAC,EAAE;IAEtB,MAAMQ,OAAM,GAAIA,CAAA,KAAM;MAEpB,IAAID,OAAO,CAACE,KAAK,EAAE;QAEjB,MAAMH,EAAC,GAAII,IAAI,CAACC,MAAM,CAAC;QAEvBP,KAAK,CAACK,KAAI,GAAI,CAAC;UAAEJ,IAAI,EAAEE,OAAO,CAACE,KAAK;UAAEH;QAAG,CAAC,EAAE,GAAGF,KAAK,CAACK,KAAK;QAE1DF,OAAO,CAACE,KAAI,GAAI,EAAC;MAEnB,OAAO;QAELN,IAAI,CAAC,UAAU;MAEjB;IAEF;IAEA,MAAMS,UAAS,GAAKN,EAAE,IAAK;MAEzBF,KAAK,CAACK,KAAI,GAAIL,KAAK,CAACK,KAAK,CAACI,MAAM,CAACC,IAAG,IAAKA,IAAI,CAACR,EAAC,IAAKA,EAAE;IAExD;IAEA,OAAO;MAAEF,KAAK;MAAEI,OAAO;MAAEI,UAAU;MAAEL;IAAQ;EAE/C;AAEF","ignoreList":[]},"metadata":{},"sourceType":"module"}