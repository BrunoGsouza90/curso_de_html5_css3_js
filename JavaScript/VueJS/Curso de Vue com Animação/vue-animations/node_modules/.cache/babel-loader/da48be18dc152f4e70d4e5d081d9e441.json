{"ast":null,"code":"import { ref } from \"vue\";\nimport gsap from \"gsap\";\nexport default {\n  setup() {\n    const icons = ref([{\n      name: 'alternate_email',\n      text: 'by email'\n    }, {\n      name: 'local_phone',\n      text: 'by phone'\n    }, {\n      name: 'local_post_office',\n      text: 'by post'\n    }, {\n      name: 'local_fire_department',\n      text: 'by smoke signal'\n    }]);\n    const beforeEnter = el => {\n      el.style.opacity = 0;\n      el.style.transform = \"translateY(100px)\";\n    };\n    const enter = (el, done) => {\n      gsap.to(el, {\n        opacity: 1,\n        y: 0,\n        duration: 0.8,\n        onComplete: done,\n        delay\n      });\n    };\n    return {\n      icons,\n      beforeEnter,\n      enter\n    };\n  }\n};","map":{"version":3,"names":["ref","gsap","setup","icons","name","text","beforeEnter","el","style","opacity","transform","enter","done","to","y","duration","onComplete","delay"],"sources":["/home/bruno/dev/apache/Bruno/curso_de_html5_css3_js/JavaScript/VueJS/Curso de Vue com Animação/vue-animations/src/views/Contact.vue"],"sourcesContent":["<script>\n\n  import { ref } from \"vue\"\n  import gsap from \"gsap\"\n\n  export default {\n\n    setup() {\n\n      const icons = ref([\n\n        { name: 'alternate_email', text: 'by email'},\n        { name: 'local_phone', text: 'by phone'},\n        { name: 'local_post_office', text: 'by post'},\n        { name: 'local_fire_department', text: 'by smoke signal'},\n\n      ])\n\n      const beforeEnter = (el) => {\n\n        el.style.opacity = 0\n        el.style.transform = \"translateY(100px)\"\n\n      }\n\n      const enter = (el, done) => {\n\n        gsap.to(el, {\n\n          opacity: 1,\n          y: 0,\n          duration: 0.8,\n          onComplete: done,\n          delay\n\n        })\n\n      }\n\n      return { icons, beforeEnter, enter }\n\n    }\n    \n  }\n\n</script>\n\n<template>\n\n  <div class=\"contact\">\n\n    <h1>Contact</h1>\n\n    <transition-group\n      appear\n      tag=\"ul\"\n      @before-enter=\"beforeEnter\"\n      @enter=\"enter\"\n    >\n\n      <li v-for=\"icon in icons\" :key=\"icon.name\">\n\n        <span class=\"material-icons\">{{ icon.name }}</span>\n\n        <div>{{ icon.text }}</div>\n\n      </li>\n\n    </transition-group>\n\n  </div>\n\n</template>\n\n<style>\n\n  .contact ul {\n\n    padding: 0;\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    grid-gap: 20px;\n    max-width: 400px;\n    margin: 60px auto;\n\n  }\n\n  .contact li {\n\n    list-style-type: none;\n    background: white;\n    padding: 30px;\n    border-radius: 10px;\n    box-shadow: 1px 3px 5px rgba(0,0,0,0.1);\n    cursor: pointer;\n    line-height: 1.5em;\n\n  }\n  \n</style>"],"mappings":"AAEE,SAASA,GAAE,QAAS,KAAI;AACxB,OAAOC,IAAG,MAAO,MAAK;AAEtB,eAAe;EAEbC,KAAKA,CAAA,EAAG;IAEN,MAAMC,KAAI,GAAIH,GAAG,CAAC,CAEhB;MAAEI,IAAI,EAAE,iBAAiB;MAAEC,IAAI,EAAE;IAAU,CAAC,EAC5C;MAAED,IAAI,EAAE,aAAa;MAAEC,IAAI,EAAE;IAAU,CAAC,EACxC;MAAED,IAAI,EAAE,mBAAmB;MAAEC,IAAI,EAAE;IAAS,CAAC,EAC7C;MAAED,IAAI,EAAE,uBAAuB;MAAEC,IAAI,EAAE;IAAiB,CAAC,CAE1D;IAED,MAAMC,WAAU,GAAKC,EAAE,IAAK;MAE1BA,EAAE,CAACC,KAAK,CAACC,OAAM,GAAI;MACnBF,EAAE,CAACC,KAAK,CAACE,SAAQ,GAAI,mBAAkB;IAEzC;IAEA,MAAMC,KAAI,GAAIA,CAACJ,EAAE,EAAEK,IAAI,KAAK;MAE1BX,IAAI,CAACY,EAAE,CAACN,EAAE,EAAE;QAEVE,OAAO,EAAE,CAAC;QACVK,CAAC,EAAE,CAAC;QACJC,QAAQ,EAAE,GAAG;QACbC,UAAU,EAAEJ,IAAI;QAChBK;MAEF,CAAC;IAEH;IAEA,OAAO;MAAEd,KAAK;MAAEG,WAAW;MAAEK;IAAM;EAErC;AAEF","ignoreList":[]},"metadata":{},"sourceType":"module"}