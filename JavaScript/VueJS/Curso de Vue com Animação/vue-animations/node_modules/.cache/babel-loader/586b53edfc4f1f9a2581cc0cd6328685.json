{"ast":null,"code":"import { ref } from 'vue';\nimport Toast from '../components/Toast';\nimport Todos from '../components/Todos';\nexport default {\n  components: {\n    Toast,\n    Todos\n  },\n  setup() {\n    const showToast = ref(false);\n    const showP = ref(false);\n    const triggerToast = () => {\n      showToast.value = true;\n      setTimeout(() => showToast.value = false, 3000);\n    };\n    return {\n      showToast,\n      triggerToast,\n      showP\n    };\n  }\n};","map":{"version":3,"names":["ref","Toast","Todos","components","setup","showToast","showP","triggerToast","value","setTimeout"],"sources":["/home/bruno/dev/apache/Bruno/curso_de_html5_css3_js/JavaScript/VueJS/Curso de Vue com Animação/vue-animations/src/views/Home.vue"],"sourcesContent":["<script>\n\n  import { ref } from 'vue'\n  import Toast from '../components/Toast'\n  import Todos from '../components/Todos'\n\n  export default {\n\n    components: { Toast, Todos },\n\n    setup() {\n\n      const showToast = ref(false)\n\n      const showP = ref(false)\n\n      const triggerToast = () => {\n\n        showToast.value = true;\n\n        setTimeout(() => showToast.value = false, 3000)\n\n      }\n\n      return { showToast, triggerToast, showP }\n\n    }\n\n  }\n  \n</script>\n\n<template>\n\n  <div class=\"home\">\n\n    <transition name=\"toast\">\n    \n      <Toast v-if=\"showToast\"/>\n\n    </transition>\n\n    <Todos @badValue=\"triggerToast\"/>\n    \n    <transition name=\"fade\">\n\n      <div v-if=\"showP\">Olá, Ninjas!</div>\n    \n    </transition>\n\n    <button @click=\"showP = !showP\" type=\"button\">Toggle</button>\n\n  </div>\n\n</template>\n\n<style>\n\n\n  /* Transições \"fade\". */\n  .fade-enter-from {\n\n    opacity: 0;\n\n  }\n\n  .fade-enter-to {\n\n    opacity: 1;\n\n  }\n\n  .fade-enter-active {\n\n    transition: all 2s ease-in-out;\n\n  }\n\n  .fade-leave-from {\n\n    opacity: 1;\n\n  }\n\n  .fade-leave-to {\n\n      opacity: 0;\n\n  }\n\n  .fade-leave-active {\n\n    transition: all 2s ease-in-out;\n\n  }\n\n  /* Transições \"toast\". */\n\n</style>"],"mappings":"AAEE,SAASA,GAAE,QAAS,KAAI;AACxB,OAAOC,KAAI,MAAO,qBAAoB;AACtC,OAAOC,KAAI,MAAO,qBAAoB;AAEtC,eAAe;EAEbC,UAAU,EAAE;IAAEF,KAAK;IAAEC;EAAM,CAAC;EAE5BE,KAAKA,CAAA,EAAG;IAEN,MAAMC,SAAQ,GAAIL,GAAG,CAAC,KAAK;IAE3B,MAAMM,KAAI,GAAIN,GAAG,CAAC,KAAK;IAEvB,MAAMO,YAAW,GAAIA,CAAA,KAAM;MAEzBF,SAAS,CAACG,KAAI,GAAI,IAAI;MAEtBC,UAAU,CAAC,MAAMJ,SAAS,CAACG,KAAI,GAAI,KAAK,EAAE,IAAI;IAEhD;IAEA,OAAO;MAAEH,SAAS;MAAEE,YAAY;MAAED;IAAM;EAE1C;AAEF","ignoreList":[]},"metadata":{},"sourceType":"module"}